# Database Connection (Neon / Supabase PostgreSQL)
# Example: postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/loop_dev"

# Authentication (NextAuth.js / Auth.js)
# Generate a secure secret using: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here-minimum-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic Claude API Configuration
# API key from Anthropic Console
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
# Model identifier as specified in project brief (defaults to latest Sonnet)
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Embeddings & Semantic Search Provider (OpenAI / pgvector)
OPENAI_API_KEY="your-openai-api-key-here"
