# Database Connection (Neon / Supabase PostgreSQL)
# Example: postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/loop_dev"

# Authentication (NextAuth.js / Auth.js)
# Generate a secure secret using: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here-minimum-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider Configuration (Google Gemini 2.5 Flash via Provider Abstraction)
# Server-side only: Used for automated sentiment analysis, scoring, and theme classification
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Optional: Claude API Configuration (if swapping provider in future)
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Embeddings & Semantic Search Provider (OpenAI / pgvector)
OPENAI_API_KEY="your-openai-api-key-here"
